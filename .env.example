# Copy to .env (gitignored) and fill in. Keys live HERE, never in source —
# the pre-re-architecture repo leaked five keys through hardcoding.
ANTHROPIC_API_KEY=

# Local inference endpoint for VLM extraction
LMSTUDIO_BASE_URL=http://192.168.56.1:12345/v1
LMSTUDIO_API_KEY=

# RAG / chat
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
CHAT_MODEL=claude-sonnet-5
INDEX_NAME=default

# Extraction tuning (see src/gcf_qna/extraction/vlm.py docstring)
VLM_MODELS=qwen/qwen3-vl-8b
PAGE_MEGAPIXELS=2.0
MAX_CONCURRENT=1

# Copy to .env (gitignored) and fill in. Keys live HERE, never in source —
# the pre-re-architecture repo leaked five keys through hardcoding.
OPENAI_API_KEY=
# Optional: any OpenAI-compatible server (e.g. LM Studio) instead of api.openai.com
#OPENAI_BASE_URL=http://192.168.56.1:12345/v1

# Local inference endpoint for VLM extraction
LMSTUDIO_BASE_URL=http://192.168.56.1:12345/v1
LMSTUDIO_API_KEY=

# RAG / chat
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
CHAT_MODEL=gpt-5.2
INDEX_NAME=default

# Extraction tuning (see src/gcf_qna/extraction/vlm.py docstring)
VLM_MODELS=qwen/qwen3-vl-8b
PAGE_MEGAPIXELS=2.0
MAX_CONCURRENT=1

# Conversation history (threads sidebar + resume). Both required to enable.
# Secret: any long random string, e.g.  openssl rand -hex 32
CHAINLIT_AUTH_SECRET=
# user:password pairs, comma-separated. One pair = shared demo login.
APP_USERS=demo:change-me
# Self-registration at /register (scrypt-hashed accounts in APP_DB). 0 disables.
ALLOW_SIGNUP=1
# Thread store (SQLite; auto-created on first boot)
#APP_DB=data/app.db

# Deployment: hostname caddy serves the app under (compose label)
FP_GCF_DOMAIN=

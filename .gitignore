# environments & runtime
venv/
__pycache__/
*.pyc
.env
.ipynb_checkpoints/
.files/
**/.chainlit/translations/
.DS_Store
.vscode/

# data & regenerable artifacts — see data/README.md
data/**
!data/README.md
!data/raw/
!data/raw/funding/
!data/raw/funding/*.csv

# Recorded eval runs are MEASUREMENTS, not regenerable artifacts: re-running
# --release calls the model 66 more times and produces a DIFFERENT sample, so
# data/eval/release_release-1.jsonl cannot be rebuilt, only replaced. Under a
# bare `data/**` it was untracked, i.e. one `git clean -xfd` away from gone.
# The directory has to be re-included first — git never descends into an
# excluded directory, so a negation on the files alone would not be reached.
!data/eval/
!data/eval/release_*.jsonl
!data/eval/answers_baseline_*.jsonl
!data/eval/rescore_*.jsonl
!data/eval/CHECKSUMS.sha256

# The corpus fact registry is an INPUT to the verifier, not an output of it:
# rag/verify.py reads it for every conflict, every registry-backed figure and
# every 'report both figures' suppression. Under a bare `data/**` it was
# untracked, so a clean checkout ran a measurably DIFFERENT system — the
# adjudicated gold scored precision 25.0% instead of 34.3%, and a claim the
# recorded release passed was newly flagged, with nothing anywhere to say the
# registry was missing. CI could not run the configuration production runs.
# Same treatment as the eval anchor, and covered by the same CHECKSUMS file.
!data/registry.json
!data/registry_v2.json

# index artifacts wherever they sit
*.faiss
*.pkl
src/gcf_qna.egg-info/

# persisted element files (copies of evidence images; regenerable)
public/app_files/
